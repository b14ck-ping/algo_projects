{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug priority_queue",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/priority_queue/priority_queue",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build priority_queue (Debug)",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
